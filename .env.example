# Copy this file to .env in the repository root before starting the apps locally.
# For production deployments, set these as environment variables in Railway / Vercel.

# ── API (Railway) ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (required).
# Local:      mongodb://127.0.0.1:27017/projectflow
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/projectflow

# Secret used to sign JWT access tokens (required, min 32 chars recommended).
# Generate a secure value with: openssl rand -base64 48
JWT_SECRET=local-development-secret-change-in-production

# Access token lifetime (optional, default 7d).
JWT_EXPIRES_IN=7d

# Port the API listens on locally (optional, default 4732).
# On Railway, PORT is injected automatically — API_PORT is only for local dev.
API_PORT=4732

# Origin allowed by the API's CORS policy.
# Local:      http://localhost:3742
# Production: https://<your-app>.vercel.app
WEB_ORIGIN=http://localhost:3742

# ── Web (Vercel) ──────────────────────────────────────────────────────────────

# Base URL of the deployed API.
# Local:      http://localhost:4732
# Production: https://<your-api>.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4732
